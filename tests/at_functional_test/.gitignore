# Files and directories created by pub.
.dart_tool/
.packages

# Conventional directory for build outputs.
build/

# Omit committing pubspec.lock for library packages; see
# https://dart.dev/guides/libraries/private-files#pubspeclock.
pubspec.lock

# Minted by the CRAM-onboarding tests, one atSign each — activation is
# one-shot per virtualenv, so two tests must never share one.
test/testData/@srie.atKeys
test/testData/@sachin.atKeys
test/testData/@colin.atKeys
test/testData/@chris.atKeys
test/testData/@xavier.atKeys
test/testData/@jeremy.atKeys
test/testData/rf2b-legacy@*.atKeys
# One per rsa2048 retrofit arm — a keyfile takes exactly one retrofit, so the
# arms that ask for RSA cannot share the file the ML-DSA arms chain through.
test/testData/rf2b-t1@*.atKeys
test/testData/rf2b-t5@*.atKeys
test/testData/rf2d-posture@*.atKeys
# FileAtKeysIo.flush keeps the previous state recoverable beside the keyfile.
test/testData/*.atKeys.bak
