{
  "name": "@atsign/at_client_web",
  "version": "0.1.0",
  "description": "atPlatform client for browsers: passkey-custodied atSign sessions over WebAssembly.",
  "license": "BSD-3-Clause",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.build.json && tsc -p test/types/tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p demo/tsconfig.json",
    "test": "vitest run",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/copy-bundle.mjs",
    "e2e": "playwright test",
    "demo": "npm run build && vite --config demo/vite.config.ts",
    "demo:build": "npm run build && vite build --config demo/vite.config.ts",
    "docs:api": "typedoc"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
